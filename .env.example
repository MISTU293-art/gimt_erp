# ==============================================================================
# GIMT ENTERPRISE ERP - PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# MAKAUT (Maulana Abul Kalam Azad University of Technology) Affiliated
# ==============================================================================

# Application Environment (production / development / staging)
APP_NAME="GIMT Enterprise ERP"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/public
APP_TIMEZONE="Asia/Kolkata"

# Database Connection (MySQL 8.x / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gimt_erp
DB_USER=root
DB_PASS=

# Institutional Affiliation Details
INSTITUTE_NAME="Global Institute of Management & Technology"
INSTITUTE_SHORT="GIMT"
AFFILIATION_BODY="MAKAUT & AICTE"
MAKAUT_COLLEGE_CODE="249"
CAMPUS_LOCATION="Palpara More, NH-34, Krishnagar, Nadia, WB - 741102"

# Security & Uploads
SESSION_LIFETIME=86400
UPLOAD_MAX_FILESIZE=25M
POST_MAX_SIZE=30M
